configuration {
	font:							"Iosevka Nerd Font 10";
    show-icons:                     true;
	icon-theme: 					"Papirus";
    display-drun: 					"";
    drun-display-format:            "{name}";
    disable-history:                false;
    fullscreen:                     false;
	hide-scrollbar: 				true;
	sidebar-mode: 					false;
}


window {
    transparency:                   rgba(28,40,54,0.5);
    background-color:               rgba(28,40,54,0.5);
    text-color:                     rgba(30,158,230,1);
	border:							0px;
	border-color:				rgba(28,40,54,1) ;
    border-radius:                  0px;
	width:							300px;
    location:                       southeast;
    x-offset:                       -10;
    y-offset:                       -44;
}

prompt {
    enabled: 						true;
	padding: 						0px 0px 0px 8px;
	background-color: 				rgba(28,40,54,0.9);
	text-color: 					rgba(30,158,230,1);
}

textbox-prompt-colon {
	padding: 						1px 0px 0px 5px;
	background-color: 				rgba(28,40,54,0.9);
	text-color: 					rgba(30,158,230,1);
	expand: false;
	str: "";
	font:							"feather 10";
}

entry {
    background-color:               rgba(28,40,54,0.9);
    text-color:                     rgba(30,158,230,1);
    placeholder-color:              rgba(30,158,230,1);
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search Applications";
    padding:                        0px 0px 0px 5px;
    blink:                          true;
}

inputbar {
	children: 						[ textbox-prompt-colon, prompt ];
    background-color:               rgba(28,40,54,0.9);
    text-color:                     rgba(30,158,230,1);
    expand:                         false;
	border:							1px;
    border-radius:                  2px;
	border-color:					@ac;
    margin:                         0px;
    padding:                        10px;
}

listview {
    background-color:               rgba(28,40,54,0.9);
    padding:                        0px;
    columns:                        1;
    lines:                          5;
    spacing:                        0px;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               rgba(28,40,54,0.9);
	border:							0px;
    border-radius:                  0px;
	border-color:					rgba(30,158,230,1);
    children:                       [ inputbar, listview ];
    spacing:                       	10px;
    padding:                        10px;
}

element {
    background-color:               rgba(28,40,54,0.9);
    text-color:                     rgba(30,158,230,1);
    orientation:                    horizontal;
    border-radius:                  0px;
    padding:                        10px 10px 10px -16px;
}

element-icon {
    background-color:               transparent;
    text-color:               		inherit;
    size:                           24px;
    border:                         0px;
}

element-text {
    background-color:               transparent;
    text-color:               		inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0px 2.5px 0px 2.5px;
}

element selected {
    background-color:               @bga;
    text-color:                     rgba(30,158,230,1);
	border:							1px;
    border-radius:                  2px;
    border-color:                  	rgba(30,158,230,1);
}
